@app.get("/api/cpu/state")
def cpu_state():
    return {
        "utilization": monitor.cpu_utilization_percent(0.1),
        "freq_mhz": monitor.cpu_frequencies_mhz(),
        "governor": monitor.cpu_governor(),
        "available_governors": monitor.cpu_available_governors(),
