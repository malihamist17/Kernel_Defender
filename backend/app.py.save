def run_cpu_experiment(seconds: int = 4, target_governor: str = None):
    result = cpu_experiment.run_experiment(seconds=seconds, target_governor=target_governor)
    db.save_experiment("cpu", result)
    return result

#-----------
@app.post("/api/experiments/tiered/run")
def run_tiered(mode: str = "baseline"):
    """Run the tiered memory policy engine. mode = baseline | adaptive."""
    if mode not in ("baseline", "adaptive"):
        return {"error": "mode must be 'baseline' or 'adaptive'"}

    tracelog.log("COMMAND", "Tiered Lab", f"./tiered {mode}")

    try:
        proc = subprocess.run(
            ["/home/mahi-rat/tiered", mode],
            capture_output=True, text=True, timeout=30,
        )
    except FileNotFoundError:
        return {"error": "binary not found at /home/mahi-rat/tiered"}
    except subprocess.TimeoutExpired:
        return {"error": "timed out"}

    output = proc.stdout

    stages = {}
    for m in re.finditer(
        r"\[(after [^\]]+)\]\s+VmRSS=(\d+)\s+kB\s+VmSwap=(\d+)\s+kB", output
    ):
        stages[m.group(1)] = {
            "vmrss_kb": int(m.group(2)),
            "vmswap_kb": int(m.group(3)),
        }

    demoted = None
    dm = re.search(r"queued (\d+) pages for demotion", output)
    if dm:
        demoted = int(dm.group(1))

    result = {
        "mode": mode,
        "stages": stages,
        "pages_demoted": demoted,
        "raw_output": output,
    }

    new_incident("tiered_memory", "LOW",
                 f"Tiered policy '{mode}': VmSwap after = "
                 f"{stages.get('after policy', {}).get('vmswap_kb', '?')} kB")
    db.save_experiment("tiered", result)
    tracelog.log("RESULT", "Tiered Lab", f"{mode} complete", result)
    return result

